rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Phera: User profiles ───────────────────────────────────────
    match /users/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;

      // AI assistant per-user weekly usage counters. Only the user themselves
      // can read or write their own counters — never another user's.
      match /assistantUsage/{weekId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ─── Helper functions ───────────────────────────────────────────
    function isOwner(weddingId) {
      return request.auth != null
        && exists(/databases/$(database)/documents/weddings/$(weddingId))
        && get(/databases/$(database)/documents/weddings/$(weddingId)).data.get('ownerId', '') == request.auth.uid;
    }

    function isCollaborator(weddingId) {
      return request.auth != null
        && request.auth.token.email != null
        && exists(/databases/$(database)/documents/weddings/$(weddingId))
        && request.auth.token.email in get(/databases/$(database)/documents/weddings/$(weddingId)).data.get('collaboratorEmails', []);
    }

    function isEditor(weddingId) {
      return isOwner(weddingId) || isCollaborator(weddingId);
    }

    function hasAccess(weddingId) {
      return isOwner(weddingId) || isCollaborator(weddingId);
    }

    // ─── Phera: Weddings ────────────────────────────────────────────
    match /weddings/{weddingId} {
      allow read: if request.auth != null
        && ((resource.data.get('ownerId', '') == request.auth.uid)
            || (request.auth.token.email is string
                && request.auth.token.email in resource.data.get('collaboratorEmails', [])));
      allow create: if request.auth != null
        && request.resource.data.get('ownerId', '') == request.auth.uid;
      // Owner and editors can update; only owner can delete
      allow update: if request.auth != null
        && ((resource.data.get('ownerId', '') == request.auth.uid)
            || (request.auth.token.email is string
                && request.auth.token.email in resource.data.get('collaboratorEmails', [])));
      allow delete: if request.auth != null
        && resource.data.get('ownerId', '') == request.auth.uid;

      // Collaborators subcollection — only owner can manage
      match /collaborators/{collabId} {
        allow read: if hasAccess(weddingId);
        allow write: if isOwner(weddingId);
      }

      // Settings subcollection
      match /settings/{settingId} {
        allow read: if hasAccess(weddingId);
        allow write: if isEditor(weddingId);
      }

      // RSVP responses — anyone can submit (public), editors can read.
      // Validate/size-cap public writes to prevent spam and oversized docs.
      match /rsvpResponses/{responseId} {
        allow read: if hasAccess(weddingId);
        allow create: if request.resource.data.respondentName is string
          && request.resource.data.respondentName.size() <= 200
          && request.resource.data.familyName is string
          && request.resource.data.familyName.size() <= 200
          && request.resource.data.email is string
          && request.resource.data.email.size() <= 200
          && request.resource.data.phone is string
          && request.resource.data.phone.size() <= 50
          && request.resource.data.message is string
          && request.resource.data.message.size() <= 2000
          && request.resource.data.method in ['web', 'whatsapp', 'manual'];
        allow update, delete: if isEditor(weddingId);
      }

      // Private event records remain inside the authenticated workspace.
      match /events/{eventId} {
        allow read: if hasAccess(weddingId);
        allow write: if isEditor(weddingId);
      }

      // Guests contain private contact, dietary, travel, and accessibility data.
      match /guests/{guestId} {
        allow read: if hasAccess(weddingId);
        // Public RSVP may only touch RSVP-related fields; anything else
        // (name, email, phone, notes, tags, …) requires an editor. This keeps
        // the unauthenticated RSVP flow working while preventing tampering.
        allow update: if isEditor(weddingId)
          || request.resource.data.diff(resource.data).affectedKeys()
               .hasOnly(['rsvpStatus', 'dietary', 'rsvpMethod', 'rsvpViewedAt', 'rsvpViewCount']);
        allow create, delete: if isEditor(weddingId);
      }

      // Minimized directory used by public RSVP and table-finder pages.
      match /publicGuests/{guestId} {
        allow read: if true;
        allow write: if isEditor(weddingId);
      }

      // Public table finder receives only table names and guest IDs.
      match /publicSeating/{eventId} {
        allow read: if true;
        allow write: if isEditor(weddingId);
      }

      // Shared photo queue is intentionally visible to wedding guests.
      match /photoGroups/{groupId} {
        allow read: if true;
        allow write: if isEditor(weddingId);
      }

      // Public wedding game configuration and leaderboard entries.
      match /bets/{configId} {
        allow read: if true;
        allow write: if isEditor(weddingId);
      }

      match /betsVotes/{voteId} {
        allow read: if true;
        allow create, update: if request.resource.data.guestName is string
          && request.resource.data.guestName.size() >= 2
          && request.resource.data.guestName.size() <= 40
          && request.resource.data.answers is map;
        allow delete: if isEditor(weddingId);
      }

      // All other subcollections: families, seating, photoGroups, bets, etc.
      match /{subcollection}/{docId} {
        allow read: if hasAccess(weddingId);
        allow write: if isEditor(weddingId);
      }
    }

    // Public projections contain only information intentionally published for
    // wedding websites, RSVP pages, and event schedules.
    match /publicWeddings/{weddingId} {
      allow read: if true;
      allow create: if request.auth != null
        && existsAfter(/databases/$(database)/documents/weddings/$(weddingId))
        && getAfter(/databases/$(database)/documents/weddings/$(weddingId)).data.get('ownerId', '') == request.auth.uid;
      allow update, delete: if isEditor(weddingId);

      match /events/{eventId} {
        allow read: if true;
        allow write: if isEditor(weddingId);
      }
    }

    // ─── Legacy: unused collections (locked down; fall through to deny) ──
    // The old singular `wedding` photo-queue collection is no longer used by
    // the live app (only referenced by dead App.legacy.jsx). Deny all access.

    // ─── Legacy: other collections ──────────────────────────────────
    match /submissions/{docId} {
      allow read: if false;
      allow create: if request.auth != null
        && request.resource.data.submittedBy == request.auth.uid
        && request.resource.data.restaurantName is string
        && request.resource.data.restaurantName.size() > 0
        && request.resource.data.restaurantName.size() <= 100
        && request.resource.data.deal is string
        && request.resource.data.deal.size() > 0
        && request.resource.data.deal.size() <= 500
        && request.resource.data.status == 'pending';
      allow update, delete: if false;
    }

    match /ratings/{restaurantKey} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    match /bookmarks/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    match /auto_deals/{docId} {
      allow read: if true;
      allow write: if false;
    }

    match /reviews/{restaurantKey} {
      allow read: if true;
      allow write: if request.auth != null;
    }

    // ─── Standalone single-use photo queue (e.g. alidatarun.com) ─────────
    // A self-contained live photo-lineup app keeps its whole state in one doc
    // per queue. It has no login (a client-side password only), so writes are
    // public but shape-validated. Isolated from Phera weddings — Phera never
    // reads or writes `photoQueues`, so this block is purely additive.
    match /photoQueues/{queueId} {
      allow read: if true;
      allow create, update: if request.resource.data.groups is list
        && request.resource.data.groups.size() <= 500
        && request.resource.data.coupleNames is string
        && request.resource.data.coupleNames.size() <= 120;
      allow delete: if false;
    }

    // deny everything else by default
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
